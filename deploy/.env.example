# Copy to deploy/.env, chmod 600; never commit real values.
# DOMAIN is a hostname, not a URL. Compose derives APP_ORIGIN=https://DOMAIN.
DOMAIN=study.example.ru
TLS_EMAIL=admin@example.ru
POSTGRES_USER=teleiosis
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_DB=teleiosis
# URL-encode password in DATABASE_URL; host is the compose service db.
DATABASE_URL=postgresql+psycopg://teleiosis:REPLACE_ME@db:5432/teleiosis?connect_timeout=5
SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# Public app association metadata; empty values keep endpoints disabled.
MOBILE_APPLICATION_ID=ru.teleiosis.mobile.dev
MOBILE_ANDROID_CERT_SHA256=[]
MOBILE_APPLE_TEAM_ID=

# Block 7 stays disabled until provider/client acceptance and approved rollout.
PUSH_ENABLED=false
LEARNING_METRICS_ENABLED=false
RUSTORE_PROJECT_ID=
RUSTORE_SERVICE_TOKEN=
