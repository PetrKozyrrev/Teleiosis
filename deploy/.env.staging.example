# Private test deployment, no external mail delivery. See docs/staging.md.
COMPOSE_PROJECT_NAME=teleiosis-staging
TELEIOSIS_IMAGE=teleiosis:staging-capture-20261116
APP_ENV=staging
EMAIL_BACKEND=capture
DOMAIN=teleiosistest.tw1.ru
# Base compose requires a value; Caddyfile.staging does not use an ACME email.
TLS_EMAIL=unused@example.invalid
POSTGRES_USER=teleiosis
POSTGRES_PASSWORD=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_DB=teleiosis
DATABASE_URL=
SECRET_KEY=
# Argon2id gateway hash, quoted to preserve '$'. Never reuse the app password.
STAGING_AUTH_HASH=
